# Пример настроек. В Яндекс Облаке задаются в переменных окружения функции (секреты — через Lockbox).
SITE_URL=https://ascorbinca234-crypto.github.io/medical_atlas
API_URL=https://xxxxxxxxxxxxxxxx.apigw.yandexcloud.net
# Случайная строка не короче 32 символов: openssl rand -base64 48
SECRET=

# YDB Serverless (Document API) и статический ключ сервисного аккаунта
YDB_DOCAPI_ENDPOINT=https://docapi.serverless.yandexcloud.net/ru-central1/b1g.../etn...
YDB_ACCESS_KEY_ID=
YDB_SECRET_ACCESS_KEY=

# Яндекс ID (oauth.yandex.ru) и VK ID (id.vk.com)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=

# Почта для писем: ящик на Яндексе и пароль приложения
SMTP_USER=atlas.noreply@yandex.ru
SMTP_PASS=
MAIL_FROM_NAME=Медицинский атлас

# Для локальной разработки (node dev-server.js):
# STORE=memory   — данные в памяти; STORE=file:./dev-db.json — в файле
# MAIL_TRANSPORT=log  MAIL_OUTBOX=./outbox.jsonl — письма в файл вместо отправки
# EXTRA_ORIGINS=http://localhost:8000 — разрешить запросы с локального сайта
